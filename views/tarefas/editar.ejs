<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exemplo MVC</title>
</head>
<body>
    <h1>Tarefódromo</h1>

    <% if (erro) { %>
        <p><%= erro %></p>
    <% } %>

    <form action="/tarefas/editar" method="post">
        <input type="hidden" value="<%= tarefa.id %>" name="id" id="id">

        <label for="nome">Título:</label>
        <input type="text" id="titulo" name="titulo" minlength="3" maxlength="100" required value="<%= tarefa.titulo %>">

        <label for="nome">Descrição:</label>
        <input type="text" id="descricao" name="descricao" maxlength="500" value="<%= tarefa.descricao %>">
        
        <label for="nome">Disciplina:</label>
        <input type="text" id="disciplina" name="disciplina" minlength="2" maxlength="80" value="<%= tarefa.disciplina %>">

        <button type="submit">Editar</button>
    </form>
</body>
</html>